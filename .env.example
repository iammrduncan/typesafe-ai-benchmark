# Shared by both workspaces; loaded by their launchers. Never commit real credentials.
# Clients use PROXY_API_KEY, which must differ from the Cerebras credential.
CEREBRAS_API_KEY=replace-with-your-cerebras-key
# Optional real TypeSafe provider for the theater. TYPESAFE_API_KEY is also accepted.
JEV_KEY=
# Optional local Needle 3: npm run setup:needle installs the pinned native model.
# The demo launcher discovers it automatically; no API key is required.
# Optional local Qwen 2.5 1.5B RLCD: npm run setup:rlcd installs the pinned MLX
# engine, weights and Python environment on Apple Silicon. No API key is required.
PROXY_API_KEY=replace-with-a-separate-proxy-key
CEREBRAS_MODEL=qwen-3.8-27b
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Optional demos bind address: localhost by default, or this machine's Tailscale IPv4.
DEMO_HOST=127.0.0.1
# Optional exact MagicDNS alias (no scheme or port), when binding to Tailscale.
# DEMO_HOSTNAME=your-machine.your-tailnet.ts.net

# Tailscale Serve on macOS should proxy a loopback upstream.
# DEMO_BIND_HOST=127.0.0.1
