{
  "name": "typesafe-ai-mimic",
  "version": "0.0.0",
  "private": true,
  "description": "A strictly validated TypeSafe and OpenAI-compatible judgment proxy backed by Cerebras.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test src/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "examples": "node --import tsx examples/run.ts",
    "examples:live": "node --env-file=.env --import tsx examples/run.ts --live"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "openai": "7.17.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "@fastify/bearer-auth": "10.1.3",
    "fastify": "5.12.5",
    "jsonc-parser": "3.3.1",
    "zod": "4.6.5"
  }
}
